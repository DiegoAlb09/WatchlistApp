@page "/estadisticas"
@attribute [Authorize]
@inject LocalStorageService WatchlistStorage
@inject LibraryStorageService LibraryStorage
@inject HistorialService HistorialStorage
@inject ToastService Toasts

<div class="header">
  <h1>
    <Icon Name="chart" /> Estadísticas
  </h1>
</div>

@if (series is null || libros is null || historial is null)
{
  <p>Cargando...</p>
}
else if (series.Count == 0 && libros.Count == 0)
{
  <div class="estado-vacio">
    <PixelCat />
    <p class="empty-msg">Todavía no hay nada agregado en ninguna sección — las estadísticas aparecerán aquí en cuanto
      agregues algo.</p>
    </div>
  }
else
  {
    <div class="stats-grid">
      <div class="stat-card">
        <span class="stat-number">@totalItems</span>
        <span class="stat-label">Títulos en total</span>
      </div>
      <div class="stat-card">
        <span class="stat-number">@totalCompletados</span>
        <span class="stat-label">Completados</span>
      </div>
      <div class="stat-card">
        <span class="stat-number">@totalEnProgreso</span>
        <span class="stat-label">En progreso</span>
      </div>
      <div class="stat-card">
        <span class="stat-number">@totalSinEmpezar</span>
        <span class="stat-label">Sin empezar</span>
      </div>
    </div>


    @if (historial.Count > 0)
    {
      <h2 class="stats-subtitle">Tu ritmo</h2>
      <div class="stats-grid ritmo-grid">
        <div class="stat-card">
          <span class="stat-number">@vistasEsteMes</span>
          <span class="stat-label">Vistas este mes</span>
          <span class="stat-detalle">@comparativaMes</span>
        </div>
        <div class="stat-card">
          <span class="stat-number">@rachaActual</span>
          <span class="stat-label">@(rachaActual == 1 ? "día de racha" : "días de racha")</span>
          <span class="stat-detalle">Sigue viva si viste algo hoy o ayer</span>
        </div>
        <div class="stat-card">
          <span class="stat-number">@mejorRacha</span>
          <span class="stat-label">Mejor racha</span>
          <span class="stat-detalle">días seguidos</span>
        </div>
      </div>
    }

    <h2 class="stats-subtitle">Progreso general por sección</h2>
    <div class="donuts-row">
      <div class="donut-card">
        <DonutChart Porcentaje="@porcentajeSeries" Color="var(--chart-1)" />
        <p>
          <Icon Name="film" /> Series y Películas
        </p>
        <span class="donut-detalle">@episodiosVistos episodios/películas vistas de @episodiosTotales</span>
      </div>
      <div class="donut-card">
        <DonutChart Porcentaje="@porcentajeLibros" Color="var(--chart-2)" />
        <p>
          <Icon Name="book" /> Libros, Manga y Cómics
        </p>
        <span class="donut-detalle">@(librosConMeta) de @(libros.Count) con meta definida</span>
      </div>
    </div>

    <h2 class="stats-subtitle">Distribución por tipo</h2>
    <BarChart Items="@barItemsPorTipo" />

    <div class="stats-titulo-fila">
      <h2 class="stats-subtitle">Vistas por mes</h2>
      <div class="filters periodo">
        @foreach (var m in new[] { 3, 6, 12 })
        {
          var valor = m;
          <button class="@(meses == valor ? "filtro-activo" : "")" @onclick="() => meses = valor">@valor meses</button>
        }
      </div>
    </div>

    @if (historial.Count == 0)
    {
      <p class="empty-msg">Todavía no tienes historial — marca algo como visto para empezar a ver esta gráfica.</p>
    }
    else
    {
      <ColumnChart Items="@columnasPorMes" />
      <span class="donut-detalle bloque-detalle">
        @historial.Count capítulos/películas vistas registradas en total
      </span>

      <h2 class="stats-subtitle">Actividad por día de la semana <span class="stats-nota">(últimos @meses meses)</span></h2>
      <BarChart Items="@barItemsPorDiaSemana" />
      <span class="donut-detalle bloque-detalle">Tu día más activo: @diaMasActivo</span>

    }
  }

@code {
  private List<WatchlistItem>? series;
  private List<LibroItem>? libros;
  private List<HistorialVisto>? historial;
  private int meses = 6;

  protected override async Task OnInitializedAsync()
  {
    try
    {
      series = await WatchlistStorage.GetAllAsync();
      libros = await LibraryStorage.GetAllAsync();
      historial = await HistorialStorage.GetAllAsync();
    }
    catch (Exception ex)
    {
      series ??= new();
      libros ??= new();
      historial ??= new();
      Toasts.Error(ApiHelper.MensajeParaToast(ex, "No se pudieron cargar las estadísticas. Revisa tu conexión con el servidor."));
    }
  }


  // ===== Ritmo: todo se calcula en HORA LOCAL (el servidor guarda UTC) =====
  private static DateTime FechaLocal(HistorialVisto h) => h.Fecha.ToLocalTime();

  private List<DateTime> diasConActividad =>
      historial?.Select(h => FechaLocal(h).Date).Distinct().OrderBy(d => d).ToList() ?? new();

  private int vistasEsteMes
  {
    get
    {
      var hoy = DateTime.Today;
      return historial?.Count(h => { var f = FechaLocal(h); return f.Year == hoy.Year && f.Month == hoy.Month; }) ?? 0;
    }
  }

  // Mes pasado hasta el mismo dia del mes (comparacion justa: no contra el mes completo).
  private int vistasMesPasadoAlDia
  {
    get
    {
      var hoy = DateTime.Today;
      var inicio = new DateTime(hoy.Year, hoy.Month, 1).AddMonths(-1);
      var dia = Math.Min(hoy.Day, DateTime.DaysInMonth(inicio.Year, inicio.Month));
      return historial?.Count(h =>
      {
        var f = FechaLocal(h);
        return f.Year == inicio.Year && f.Month == inicio.Month && f.Day <= dia;
      }) ?? 0;
    }
  }

  private string comparativaMes
  {
    get
    {
      var d = vistasEsteMes - vistasMesPasadoAlDia;
      if (d == 0) return "Igual que el mes pasado a esta fecha";
      return d > 0
          ? $"▲ {d} más que el mes pasado a esta fecha"
          : $"▼ {-d} menos que el mes pasado a esta fecha";
    }
  }

  private int rachaActual
  {
    get
    {
      var dias = new HashSet<DateTime>(diasConActividad);
      var d = DateTime.Today;
      if (!dias.Contains(d)) d = d.AddDays(-1); // la racha sigue viva si ayer hubo actividad
      var n = 0;
      while (dias.Contains(d)) { n++; d = d.AddDays(-1); }
      return n;
    }
  }

  private int mejorRacha
  {
    get
    {
      var dias = diasConActividad;
      if (dias.Count == 0) return 0;
      int mejor = 1, actual = 1;
      for (int i = 1; i < dias.Count; i++)
      {
        if ((dias[i] - dias[i - 1]).Days == 1) { actual++; mejor = Math.Max(mejor, actual); }
        else actual = 1;
      }
      return mejor;
    }
  }

  // ===== Actividad por dia de la semana (respeta el selector de periodo) =====
  private static readonly (DayOfWeek Dia, string Nombre)[] DiasSemana =
  {
        (DayOfWeek.Monday, "Lunes"), (DayOfWeek.Tuesday, "Martes"), (DayOfWeek.Wednesday, "Miércoles"),
        (DayOfWeek.Thursday, "Jueves"), (DayOfWeek.Friday, "Viernes"), (DayOfWeek.Saturday, "Sábado"),
        (DayOfWeek.Sunday, "Domingo")
    };

  private int[] conteoPorDiaSemana
  {
    get
    {
      var conteo = new int[7];
      var desde = DateTime.Today.AddMonths(-meses);
      foreach (var h in historial ?? new())
      {
        var f = FechaLocal(h);
        if (f.Date >= desde) conteo[(int)f.DayOfWeek]++;
      }
      return conteo;
    }
  }

  private List<BarChart.BarItem> barItemsPorDiaSemana
  {
    get
    {
      var conteo = conteoPorDiaSemana;
      var max = conteo.Max();
      return DiasSemana.Select(d => new BarChart.BarItem
      {
        Label = d.Nombre,
        Valor = conteo[(int)d.Dia],
        Color = max > 0 && conteo[(int)d.Dia] == max ? "var(--chart-1)" : "var(--chart-4)"
      }).ToList();
    }
  }

  private string diaMasActivo
  {
    get
    {
      var conteo = conteoPorDiaSemana;
      var max = conteo.Max();
      if (max == 0) return "—";
      return string.Join(" y ", DiasSemana.Where(d => conteo[(int)d.Dia] == max).Select(d => d.Nombre));
    }
  }

  private int totalItems => (series?.Count ?? 0) + (libros?.Count ?? 0);

  private int totalCompletados =>
      (series?.Count(i => i.EstaCompleta) ?? 0) + (libros?.Count(i => i.EstaCompleta) ?? 0);

  private int totalEnProgreso =>
      (series?.Count(i => !i.EstaCompleta && i.UnidadesVistas > 0) ?? 0) +
      (libros?.Count(i => !i.EstaCompleta && i.CapitulosLeidos > 0) ?? 0);

  private int totalSinEmpezar => totalItems - totalCompletados - totalEnProgreso;

  private int episodiosTotales => series?.Sum(i => i.TotalUnidades) ?? 0;
  private int episodiosVistos => series?.Sum(i => i.UnidadesVistas) ?? 0;

  private double porcentajeSeries =>
      episodiosTotales == 0 ? 0 : Math.Round(episodiosVistos * 100.0 / episodiosTotales, 0);

  private int librosConMeta => libros?.Count(i => i.Porcentaje is not null) ?? 0;

  private double porcentajeLibros
  {
    get
    {
      var conMeta = libros?.Where(i => i.Porcentaje is not null).ToList() ?? new();
      return conMeta.Count == 0 ? 0 : Math.Round(conMeta.Average(i => i.Porcentaje!.Value), 0);
    }
  }

  private List<BarChart.BarItem> barItemsPorTipo => new()
    {
        new() { Label = "Series", Valor = series?.Count(i => i.Tipo == TipoContenido.Serie) ?? 0, Color = "var(--chart-1)" },
        new() { Label = "Películas", Valor = series?.Count(i => i.Tipo == TipoContenido.Pelicula) ?? 0, Color = "var(--chart-2)" },
        new() { Label = "Libros", Valor = libros?.Count(i => i.Tipo == TipoLibro.Libro) ?? 0, Color = "var(--chart-3)" },
        new() { Label = "Manga", Valor = libros?.Count(i => i.Tipo == TipoLibro.Manga) ?? 0, Color = "var(--chart-4)" },
        new() { Label = "Cómics", Valor = libros?.Count(i => i.Tipo == TipoLibro.Comic) ?? 0, Color = "var(--chart-5)" },
    };

  private List<ColumnChart.ColumnItem> columnasPorMes
  {
    get
    {
      if (historial is null || historial.Count == 0)
        return new();

      var conteoPorMes = historial
          .GroupBy(h => new DateTime(h.Fecha.Year, h.Fecha.Month, 1))
          .ToDictionary(g => g.Key, g => g.Count());

      var resultado = new List<ColumnChart.ColumnItem>();
      var mesActual = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);

      for (int i = meses - 1; i >= 0; i--)
      {
        var mes = mesActual.AddMonths(-i);
        conteoPorMes.TryGetValue(mes, out var cantidad);

        resultado.Add(new ColumnChart.ColumnItem
        {
          Label = mes.ToString("MMM yy"),
          Valor = cantidad,
          Actual = i == 0
        });
      }

      return resultado;
    }
  }
}