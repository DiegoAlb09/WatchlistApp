@page "/agregar"
@page "/agregar/{Id:guid}"
@attribute [Authorize]
@inject LocalStorageService Storage
@inject ToastService Toasts
@inject NavigationManager Nav

<div class="header">
  <h1>
    <Icon Name="@(EsEdicion ? "pencil" : "film")" /> @(EsEdicion ? "Editar" : "Agregar") a la Watchlist
  </h1>
</div>

<EditForm Model="item" OnValidSubmit="Guardar" class="form-agregar">
  <DataAnnotationsValidator />

  <label>Título</label>
  <InputText @bind-Value="item.Titulo" type="text" placeholder="Ej. One Piece" />

  <label>Portada (URL de la imagen)</label>
  <InputText @bind-Value="item.PortadaUrl" type="url" placeholder="https://..." />

  @if (!string.IsNullOrWhiteSpace(item.PortadaUrl))
  {
    <div class="preview" style="background-image:url('@item.PortadaUrl')"></div>
  }

  <label>Tipo</label>
  <div class="tipo-selector">
    <label>
      <input type="radio" name="tipo" checked="@(item.Tipo == TipoContenido.Pelicula)"
            @onchange="() => item.Tipo = TipoContenido.Pelicula" />
      Película
    </label>
    <label>
      <input type="radio" name="tipo" checked="@(item.Tipo == TipoContenido.Serie)"
            @onchange="() => item.Tipo = TipoContenido.Serie" />
      Serie
    </label>
  </div>

  @if (item.Tipo == TipoContenido.Serie)
  {
    <label>Rango de capítulos pendientes</label>
    <div class="rango-episodios">
      <InputNumber @bind-Value="item.EpisodioInicio" placeholder="Desde (ej. 1169)" />
      <span class="rango-separador">–</span>
      <InputNumber @bind-Value="item.EpisodioFin" placeholder="Hasta (ej. 1170)" />
    </div>
    @if (item.EpisodioInicio is not null && item.EpisodioFin is not null && item.EpisodioFin < item.EpisodioInicio)
    {
      <p class="rango-error">El capítulo "Hasta" debe ser mayor o igual que "Desde".</p>
    }

    <label class="checkbox-inline">
      <input type="checkbox" checked="@item.EnEmision" @onchange="e => item.EnEmision = (bool)e.Value!" />
      <Icon Name="calendar" /> En emisión (aparece en el calendario de estrenos)
    </label>

    @if (item.EnEmision)
    {
      <label>Día de emisión (semanal)</label>
      <select class="sort-select" @onchange="OnDiaEmisionChanged">
        <option value="-1" selected="@(item.DiaEmision is null)">Selecciona un día</option>
        @foreach (var (dia, nombre) in DiasEmision.Todos)
        {
          <option value="@((int)dia)" selected="@(item.DiaEmision == dia)">@nombre</option>
        }
      </select>

      <label>Desde (día / mes / año)</label>
      <div class="rango-episodios">
        <InputNumber @bind-Value="diaInicio" placeholder="Día" />
        <InputNumber @bind-Value="mesInicio" placeholder="Mes" />
        <InputNumber @bind-Value="anioInicio" placeholder="Año" />
      </div>

      <label>Hasta (día / mes / año) — déjalo vacío si aún no termina</label>
      <div class="rango-episodios">
        <InputNumber @bind-Value="diaFin" placeholder="Día" />
        <InputNumber @bind-Value="mesFin" placeholder="Mes" />
        <InputNumber @bind-Value="anioFin" placeholder="Año" />
      </div>

      @if (!string.IsNullOrWhiteSpace(errorFechas))
      {
        <p class="rango-error">@errorFechas</p>
      }
    }
  }

  <div class="form-buttons">
    <button type="submit" class="btn-add" disabled="@guardando">@(guardando ? "Guardando..." : (EsEdicion ? "Guardar cambios" : "Guardar"))</button>
    <button type="button" class="btn-cancel" @onclick="Cancelar">Cancelar</button>
  </div>
</EditForm>

@code {
  [Parameter] public Guid? Id { get; set; }

  private WatchlistItem item = new();
  private bool EsEdicion => Id is not null;
  private string? errorFechas;
  private bool guardando;

  private int? diaInicio, mesInicio, anioInicio;
  private int? diaFin, mesFin, anioFin;

  protected override async Task OnInitializedAsync()
  {
    if (EsEdicion)
    {
      var existente = (await Storage.GetAllAsync()).FirstOrDefault(i => i.Id == Id);
      if (existente is not null)
      {
        item = existente;

        if (item.FechaInicioEmision is not null)
        {
          diaInicio = item.FechaInicioEmision.Value.Day;
          mesInicio = item.FechaInicioEmision.Value.Month;
          anioInicio = item.FechaInicioEmision.Value.Year;
        }

        if (item.FechaFinEmision is not null)
        {
          diaFin = item.FechaFinEmision.Value.Day;
          mesFin = item.FechaFinEmision.Value.Month;
          anioFin = item.FechaFinEmision.Value.Year;
        }
      }
    }
  }

  private void OnDiaEmisionChanged(ChangeEventArgs e)
  {
    if (int.TryParse(e.Value?.ToString(), out var valor) && valor >= 0)
      item.DiaEmision = (DayOfWeek)valor;
    else
      item.DiaEmision = null;
  }

  private static DateTime? ConstruirFecha(int? dia, int? mes, int? anio)
  {
    if (dia is null || mes is null || anio is null)
      return null;

    try
    {
      return new DateTime(anio.Value, mes.Value, dia.Value);
    }
    catch (ArgumentOutOfRangeException)
    {
      return null;
    }
  }

  private async Task Guardar()
  {
    errorFechas = null;

    if (string.IsNullOrWhiteSpace(item.Titulo))
      return;

    if (item.Tipo == TipoContenido.Pelicula)
    {
      item.EpisodioInicio = null;
      item.EpisodioFin = null;
      item.EnEmision = false;
      item.DiaEmision = null;
      item.FechaInicioEmision = null;
      item.FechaFinEmision = null;
    }
    else
    {
      if (item.EpisodioInicio is null || item.EpisodioFin is null || item.EpisodioFin < item.EpisodioInicio)
        return;

      item.EpisodiosVistos = item.EpisodiosVistos
          .Where(e => e >= item.EpisodioInicio && e <= item.EpisodioFin)
          .ToList();

      if (!item.EnEmision)
      {
        item.DiaEmision = null;
        item.FechaInicioEmision = null;
        item.FechaFinEmision = null;
      }
      else
      {
        var soloAlgunosCamposInicio = (diaInicio is not null || mesInicio is not null || anioInicio is not null)
            && (diaInicio is null || mesInicio is null || anioInicio is null);
        var soloAlgunosCamposFin = (diaFin is not null || mesFin is not null || anioFin is not null)
            && (diaFin is null || mesFin is null || anioFin is null);

        if (soloAlgunosCamposInicio || soloAlgunosCamposFin)
        {
          errorFechas = "Completa día, mes y año, o deja los tres vacíos.";
          return;
        }

        item.FechaInicioEmision = ConstruirFecha(diaInicio, mesInicio, anioInicio);
        item.FechaFinEmision = ConstruirFecha(diaFin, mesFin, anioFin);

        if ((diaInicio is not null && item.FechaInicioEmision is null) ||
            (diaFin is not null && item.FechaFinEmision is null))
        {
          errorFechas = "Alguna de las fechas no es válida (revisa el día para ese mes).";
          return;
        }

        if (item.FechaInicioEmision is not null && item.FechaFinEmision is not null
            && item.FechaFinEmision < item.FechaInicioEmision)
        {
          errorFechas = "La fecha \"Hasta\" debe ser posterior a la fecha \"Desde\".";
          return;
        }
      }
    }

    guardando = true;
    try
    {
      if (EsEdicion)
      {
        await Storage.UpdateAsync(item);
        Toasts.Exito($"\"{item.Titulo}\" actualizado.");
      }
      else
      {
        await Storage.AddAsync(item);
        Toasts.Exito($"\"{item.Titulo}\" agregado a tu watchlist.");
      }

      Nav.NavigateTo("/");
    }
    catch (Exception)
    {
      Toasts.Error("No se pudo guardar. Revisa tu conexión con el servidor.");
    }
    finally
    {
      guardando = false;
    }
  }

  private void Cancelar() => Nav.NavigateTo("/");
}