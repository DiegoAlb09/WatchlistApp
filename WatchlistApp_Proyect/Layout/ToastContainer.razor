@implements IDisposable
@inject ToastService Toasts

<div class="toast-stack">
  @foreach (var toast in Toasts.Mensajes.ToList())
  {
    <div class="toast toast-@ClaseTipo(toast.Tipo)" @key="toast.Id">
      <Icon Name="@IconTipo(toast.Tipo)" />
      <span>@toast.Texto</span>
      <button class="toast-cerrar" @onclick="() => Toasts.Cerrar(toast.Id)">✕</button>
    </div>
  }
</div>

@code {
  protected override void OnInitialized()
  {
    Toasts.OnChange += Refrescar;
  }

  private void Refrescar() => InvokeAsync(StateHasChanged);

  private static string ClaseTipo(TipoToast tipo) => tipo switch
  {
    TipoToast.Exito => "exito",
    TipoToast.Error => "error",
    _ => "info"
  };

  public static string IconTipo(TipoToast tipo) => tipo switch
  {
    TipoToast.Exito => "check",
    TipoToast.Error => "alerta",
    _ => "alerta"
  };

  public void Dispose()
  {
    Toasts.OnChange -= Refrescar;
  }
}