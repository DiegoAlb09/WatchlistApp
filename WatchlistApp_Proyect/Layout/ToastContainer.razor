@implements IDisposable
@inject ToastService Toasts

<div class="notif-stack" aria-live="polite">
  @foreach (var toast in Toasts.Mensajes.ToList())
  {
    <div class="notif notif-@ClaseTipo(toast.Tipo)" @key="toast.Id">
      <Icon Name="@IconoTipo(toast.Tipo)" />
      <span>@toast.Texto</span>
      <button class="notif-cerrar" @onclick="() => Toasts.Cerrar(toast.Id)">✕</button>
    </div>
  }
</div>

@code {
  protected override void OnInitialized() => Toasts.OnChange += Refrescar;

  private void Refrescar() => InvokeAsync(StateHasChanged);

  private static string ClaseTipo(TipoToast tipo) => tipo switch
  {
    TipoToast.Exito => "exito",
    TipoToast.Error => "error",
    _ => "info"
  };

  private static string IconoTipo(TipoToast tipo) => tipo == TipoToast.Exito ? "check" : "alerta";

  public void Dispose() => Toasts.OnChange -= Refrescar;
}
