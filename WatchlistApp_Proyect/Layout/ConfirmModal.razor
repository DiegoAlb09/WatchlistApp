@implements IDisposable
@inject ConfirmService Confirm

@if (Confirm.Visible)
{
  <div class="modal-overlay" onclick="() => Confirm.Responder(false)">
    <div class="modal-card" @onclick:stopPropagation="true">
      <div class="modal-icono">
        <Icon Name="alerta" />
      </div>
      <h3>@Confirm.Titulo</h3>
      <p class="modal-mensaje">@Confirm.Mensaje</p>

      <div class="modal-actions">
        <button class="btn-cancel" @onclick="() => Confirm.Responder(false)">
          Cancelar
        </button>
        <button class="btn-delete-confirm" @onclick="() => Confirm.Responder(true)">
          Eliminar
        </button>
      </div>
    </div>
  </div>
}

@code {
  protected override void OnInitialized()
  {
    Confirm.OnChange += Refrescar;
  }

  private void Refrescar() => InvokeAsync(StateHasChanged);

  public void Dispose()
  {
    Confirm.OnChange -= Refrescar;
  }
}