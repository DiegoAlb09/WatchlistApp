@using System.Globalization
@* Barras horizontales PROPORCIONALES: el ancho de cada una es su valor / el valor maximo.
   El ancho se escribe con InvariantCulture para que nunca salga "42,4%" (CSS invalido). *@
<div class="bar-chart">
  @foreach (var item in Items)
  {
    <div class="bar-row">
      <span class="bar-label">@item.Label</span>
      <div class="bar-track">
        <div class="bar-fill" style="width:@Ancho(item.Valor)%; background:@item.Color"></div>
      </div>
      <span class="bar-value">@item.Valor.ToString("0")</span>
    </div>
  }
</div>

@code {
  public class BarItem
  {
    public string Label { get; set; } = "";
    public double Valor { get; set; }
    public string Color { get; set; } = "var(--accent)";
  }

  [Parameter] public List<BarItem> Items { get; set; } = new();

  private double Maximo => Items.Count == 0 ? 0 : Items.Max(i => i.Valor);

  private string Ancho(double valor)
  {
    if (Maximo <= 0 || valor <= 0) return "0";
    var pct = valor * 100.0 / Maximo;
    pct = Math.Clamp(pct, 2, 100); // minimo 2%: un valor chico igual se ve
    return pct.ToString("0.##", CultureInfo.InvariantCulture);
  }
}